# Nudge Chapters — environment variables
#
# Development:  cp .env.example .env.local   (git ignores .env.local)
# Production:   set the same names as GitHub repository variables
#               (Settings → Secrets and variables → Actions → Variables);
#               .github/workflows/deploy.yml passes them to the build.
#
# Every variable here starts with NEXT_PUBLIC_, which means it is compiled into
# the JavaScript sent to the browser. Only put PUBLIC values here.
# Never add a Supabase service_role / secret key, database password or token.

# Supabase → Project Settings → API. The publishable (or legacy anon) key is
# safe to expose; row-level security protects each user's data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# (A legacy anon key also works: NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...)

# Buy Me a Coffee — your buymeacoffee.com username (the part after buymeacoffee.com/)
NEXT_PUBLIC_BMC_USERNAME=
# Show the floating Buy Me a Coffee button on desktop (true/false)
NEXT_PUBLIC_BMC_WIDGET=false

# Optional: show "Continue with Google" (enable the Google provider in Supabase → Authentication first)
NEXT_PUBLIC_AUTH_GOOGLE=false

# Optional: app name shown in the UI
NEXT_PUBLIC_APP_NAME="Nudge Chapters"

# Deployment only — leave empty for local development.
# Sub-path the site is served from (GitHub Pages project sites: "/<repo-name>").
NEXT_PUBLIC_BASE_PATH=
# Public URL of the deployment, used for Open Graph link previews.
NEXT_PUBLIC_SITE_URL=
